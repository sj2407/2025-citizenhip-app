# Anthropic API Key for intelligent answer evaluation
# Get your key at: https://console.anthropic.com/
# This is optional - the app works without it using simple matching
VITE_ANTHROPIC_API_KEY=your_api_key_here

# Google Civic Information API Key for fetching live representative data
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable the "Google Civic Information API" in your Google Cloud project
# This is optional - the app falls back to static data without it
VITE_GOOGLE_CIVIC_API_KEY=your_google_api_key_here
